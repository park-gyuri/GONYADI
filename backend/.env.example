# === DB 설정 ===
# [방법 A] Supabase 등 외부 DB — DATABASE_URL 하나만 입력 (아래 개별 항목 무시됨)
# Settings → Database → Connection string → URI 복사
DATABASE_URL=

# [방법 B] 로컬 Docker DB — 아래 항목 입력 (DATABASE_URL 비워두면 이 값 사용)
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_HOST=localhost
DB_PORT=5432

# === API Keys ===
GEMINI_API_KEY=
GOOGLE_MAPS_API_KEY=
TMAP_APP_KEY=
ORS_API_KEY=
ODSAY_API_KEY=

# === 인증 ===
SECRET_KEY=